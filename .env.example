# 星观台 iOS TestFlight 构建配置
# 复制为 .env 并填入真实值：cp .env.example .env

# Apple Developer Team ID（10 位字母数字，在 developer.apple.com → Membership 查看）
DEVELOPMENT_TEAM=XXXXXXXXXX
TEAM_ID=XXXXXXXXXX

# App Store Connect 上传用 Apple ID
APPLE_ID=your@email.com

# 方式 A：App 专用密码（appleid.apple.com → 登录与安全 → App 专用密码）
# APP_STORE_CONNECT_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 方式 B：App Store Connect API Key（推荐 CI）
# APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
# APP_STORE_CONNECT_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APP_STORE_CONNECT_API_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# Xcode scheme 名称（Capacitor 默认为 App）
IOS_SCHEME=App
